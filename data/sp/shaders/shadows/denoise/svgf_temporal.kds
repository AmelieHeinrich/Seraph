#include "kd/shaders/common/bindless.kds"
#include "sp/shaders/common/camera.kds"
#include "sp/shaders/common/math.kds"
#include "sp/shaders/common/compute.kds"

#pragma compute CSMain

struct PushConstants
{
    uint PrevID;
    uint CurrID;
    uint HistoryID;
    uint MotionID;

    uint Width;
    uint Height;
    uint NormalID;
    uint PrevNormalID;

    uint DepthID;
    uint PrevDepthID;
    uint CameraBuffer;
    uint SamplerID;

    uint PrevMomentsID;
    uint MomentsID;
    uint2 Pad;
};
PUSH_CONSTANTS(PushConstants, Push);

bool DoOffscreenCheck(float2 historyUV)
{
    if (historyUV.x < 0.0 || historyUV.x > 1.0 ||
        historyUV.y < 0.0 || historyUV.y > 1.0)
        return false;
    return true;
}

bool DoPlaneCheck(uint2 tid, float2 currUV, float2 historyUV)
{
    Texture2D<float> depth = ResourceDescriptorHeap[Push.DepthID];
    Texture2D<float> prevDepth = ResourceDescriptorHeap[Push.PrevDepthID];
    Texture2D<float4> normal = ResourceDescriptorHeap[Push.NormalID];
    ConstantBuffer<Camera> camera = ResourceDescriptorHeap[Push.CameraBuffer];
    SamplerState bilinearSampler = SamplerDescriptorHeap[Push.SamplerID];

    // reconstruct positions
    float currZ = depth.Sample(bilinearSampler, currUV);
    float prevZ = prevDepth.Sample(bilinearSampler, historyUV);
    float3 currNormal = normal.Load(uint3(tid,0)).rgb;

    float3 currPos = GetWorldFromDepth(currUV, currZ, camera.InvViewProj).xyz;
    float3 prevPos = GetWorldFromDepth(historyUV, prevZ, camera.InvViewProj).xyz;

    float3 toCurrent = currPos - prevPos;
    float distToPlane = abs(dot(toCurrent, currNormal));
    return distToPlane < 5.0f;
}

bool DoNormalCheck(uint2 tid, float2 currUV, float2 historyUV)
{
    Texture2D<float4> normal = ResourceDescriptorHeap[Push.NormalID];
    Texture2D<float4> prevNormalTex = ResourceDescriptorHeap[Push.PrevNormalID];
    SamplerState bilinearSampler = SamplerDescriptorHeap[Push.SamplerID];

    float3 currNormal = normalize(normal.Sample(bilinearSampler, currUV).rgb);
    float3 prevNormal = normalize(prevNormalTex.Sample(bilinearSampler, historyUV).rgb);
    return dot(currNormal, prevNormal) > 0.9f;
}

bool DoMeshIDCheck(uint2 tid, float2 currUV, float2 historyUV)
{
    Texture2D<float4> normal = ResourceDescriptorHeap[Push.NormalID];
    Texture2D<float4> prevNormalTex = ResourceDescriptorHeap[Push.PrevNormalID];
    SamplerState bilinearSampler = SamplerDescriptorHeap[Push.SamplerID];

    float curr = normal.Sample(bilinearSampler, currUV).a;
    float prev = prevNormalTex.Sample(bilinearSampler, historyUV).a;
    return curr == prev;
}

bool IsSampleValid(uint2 tid, float2 currUV, float2 historyUV)
{
    if (!DoOffscreenCheck(historyUV)) return false;
    if (!DoMeshIDCheck(tid, currUV, historyUV)) return false;
    if (!DoPlaneCheck(tid, currUV, historyUV)) return false;
    if (!DoNormalCheck(tid, currUV, historyUV)) return false;
    return true;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 dtid : SV_DispatchThreadID)
{
    if (dtid.x >= Push.Width || dtid.y >= Push.Height)
        return;

    RWTexture2D<float> curr = ResourceDescriptorHeap[Push.CurrID];
    RWTexture2D<uint> history = ResourceDescriptorHeap[Push.HistoryID];
    RWTexture2D<float2> currMoments = ResourceDescriptorHeap[Push.MomentsID];
    Texture2D<float2> prevMoments = ResourceDescriptorHeap[Push.PrevMomentsID];
    Texture2D<float> prev = ResourceDescriptorHeap[Push.PrevID];
    Texture2D<float2> motionVec = ResourceDescriptorHeap[Push.MotionID];
    SamplerState bilinearSampler = SamplerDescriptorHeap[Push.SamplerID];

    uint2 pixel = dtid.xy;
    float2 currUV = TexelToUV(pixel, float2(Push.Width, Push.Height));

    float prevSample = prev.Sample(bilinearSampler, currUV);
    float currSample = curr[pixel];
    uint historyLength = history[pixel];
    float2 motionVector = motionVec.Load(dtid);
    float2 historyUV = currUV + motionVector;

    float2 newMoments = 0.0f;
    float2 moments = prevMoments.Sample(bilinearSampler, historyUV);

    if (IsSampleValid(pixel, currUV, historyUV)) {
        historyLength = min(historyLength + 1, 32);
        float neighborhoodMin = +10000000000000000;
        float neighborhoodMax = -10000000000000000;

        for (int dy = -3; dy <= 3; dy++) {
            for (int dx = -3; dx <= 3; dx++) {
                float n = curr[pixel + int2(dx,dy)];
                neighborhoodMin = min(neighborhoodMin, n);
                neighborhoodMax = max(neighborhoodMax, n);
            }
        }
        float mean = moments.x;
        float var  = max(moments.y - mean * mean, 0.0);
        float sigma = sqrt(var);
        float lower = mean - 3.0 * sigma;
        float upper = mean + 3.0 * sigma;
        prevSample = clamp(prevSample, neighborhoodMin, neighborhoodMax);

        float alpha = max(1.0 / historyLength, 0.01);
        currSample = lerp(prevSample, currSample, alpha);
        history[pixel] = historyLength;

        newMoments.r = currSample;
        newMoments.g = newMoments.r * newMoments.r;
        newMoments = lerp(moments, newMoments, alpha);
    } else {
        newMoments.r = currSample;
        newMoments.g = newMoments.r * newMoments.r;
        history[pixel] = 1;
    }

    currMoments[pixel] = newMoments;
    curr[pixel] = currSample;
}
