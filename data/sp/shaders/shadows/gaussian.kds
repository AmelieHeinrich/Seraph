#include "kd/shaders/common/bindless.kds"
#include "sp/shaders/common/camera.kds"
#include "sp/shaders/common/math.kds"
#include "sp/shaders/common/compute.kds"

#pragma compute CSMain

struct PushConstants
{
    uint ShadowInID;
    uint ShadowOutID;
    uint DepthID;
    uint Width;

    uint Height;
    uint Direction;
    int KernelRadius;
    float SigmaSpatial;
    
    float SigmaDepth;
    float ZNear;
    float2 Pad;
};
PUSH_CONSTANTS(PushConstants, Push);

static const float gKernel[21] = {
    0.011195f, 0.016370f, 0.022999f, 0.031045f, 0.040263f,
    0.050171f, 0.060066f, 0.069092f, 0.076359f, 0.081081f,
    0.082718f,
    0.081081f, 0.076359f, 0.069092f, 0.060066f, 0.050171f,
    0.040263f, 0.031045f, 0.022999f, 0.016370f, 0.011195f
};

[numthreads(8, 8, 1)]
void CSMain(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= Push.Width || tid.y >= Push.Height)
        return;
    int2 pixel = tid.xy;

    Texture2D<float> shadowIn   = ResourceDescriptorHeap[Push.ShadowInID];
    RWTexture2D<float> shadowOut = ResourceDescriptorHeap[Push.ShadowOutID];

    int2 offset = (Push.Direction == 0) ? int2(1, 0) : int2(0, 1);

    float result = 0.0;

    // Apply 1D Gaussian blur
    for (int i = -Push.KernelRadius; i <= Push.KernelRadius; i++) {
        int2 coord = pixel + offset * i;
        if (coord.x < 0 || coord.y < 0 || coord.x >= Push.Width || coord.y >= Push.Height)
            continue;

        float sample = shadowIn[coord];
        result += sample * gKernel[i + Push.KernelRadius];
    }

    shadowOut[pixel] = result;
}
