#include "kd/shaders/common/bindless.kds"
#include "sp/shaders/common/camera.kds"
#include "sp/shaders/common/math.kds"
#include "sp/shaders/common/compute.kds"

#pragma compute CSMain

struct PushConstants
{
    uint PrevID;
    uint CurrID;
    uint HistoryID;
    uint MotionID;

    uint Width;
    uint Height;
    uint NormalID;
    uint PrevNormalID;

    uint DepthID;
    uint PrevDepthID;
    uint CameraBuffer;
    uint Pad;
};
PUSH_CONSTANTS(PushConstants, Push);

bool DoPlaneCheck(uint3 tid, float2 historyCoord)
{
    Texture2D<float> depth = ResourceDescriptorHeap[Push.DepthID];
    Texture2D<float> prevDepth = ResourceDescriptorHeap[Push.PrevDepthID];
    Texture2D<float4> normal = ResourceDescriptorHeap[Push.NormalID];
    ConstantBuffer<Camera> camera = ResourceDescriptorHeap[Push.CameraBuffer];

    float2 uv = TexelToUV(tid.xy, float2(Push.Width, Push.Height));
    float2 prevUV = TexelToUV(historyCoord, float2(Push.Width, Push.Height));
    float3 currPosition = GetViewFromDepth(uv, depth.Load(tid), camera.InvView).xyz;
    float3 prevPosition = GetViewFromDepth(prevUV, prevDepth.Load(tid), camera.InvView).xyz;
    float3 currNormal = normal.Load(tid).rgb;

    float3 toCurrent = currPosition - prevPosition;
    float distToPlane = abs(dot(toCurrent, currNormal));

    return distToPlane < 5.0f;
}

bool DoNormalCheck(uint3 tid, float2 historyCoord)
{
    Texture2D<float4> normal = ResourceDescriptorHeap[Push.NormalID];
    Texture2D<float4> prev = ResourceDescriptorHeap[Push.PrevNormalID];

    float3 currNormal = normal.Load(tid).rgb;
    float3 prevNormal = prev.Load(uint3(historyCoord, 1.0)).rgb;

    if (pow(abs(dot(currNormal, prevNormal)), 2) > 0.1f)
        return false;
    else
        return true;    
}

bool IsSampleValid(uint3 tid)
{
    Texture2D<float2> motionVec = ResourceDescriptorHeap[Push.MotionID];
    float2 motionVector = motionVec.Load(tid);
    float2 historyPosition = tid.xy + motionVector;

    if (!DoPlaneCheck(tid, historyPosition)) return false;
    if (!DoNormalCheck(tid, historyPosition)) return false;
    return true;
}

[numthreads(8, 8, 1)]
void CSMain(uint3 dtid : SV_DispatchThreadID)
{
    if (dtid.x >= Push.Width || dtid.y >= Push.Height)
        return;

    RWTexture2D<float> prev = ResourceDescriptorHeap[Push.PrevID];
    RWTexture2D<float> curr = ResourceDescriptorHeap[Push.CurrID];
    RWTexture2D<uint> history = ResourceDescriptorHeap[Push.HistoryID];

    float prevSample = prev[dtid.xy];
    float currSample = curr[dtid.xy];
    uint historyLength = history[dtid.xy];

    if (IsSampleValid(dtid)) {
        currSample = lerp(prevSample, currSample, 1.0 / historyLength);
        history[dtid.xy]++;
    } else {
        history[dtid.xy] = 1;
        prev[dtid.xy] = currSample;
    }

    curr[dtid.xy] = currSample;
}
